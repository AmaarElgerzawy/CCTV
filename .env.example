# Copy this file to .env and fill in your DVR details.
# Never commit .env (it is already ignored by .gitignore).
DVR_HOST=192.168.1.100
DVR_USER=admin
DVR_PASS=your-password-here

# On-demand live view through go2rtc (Phase 3b).
# GO2RTC_URL is the backend-to-go2rtc API address.
# PUBLIC_GO2RTC_URL is the address the browser uses for the player.
# Through an SSH tunnel both normally remain http://127.0.0.1:1984.
GO2RTC_URL=http://127.0.0.1:1984
PUBLIC_GO2RTC_URL=http://127.0.0.1:1984
# Transcode H.265 to H.264 for the browser. Leave true for this DVR.
STREAM_TRANSCODE_H264=true
# Highest accepted channel number (channels 1..MAX_CHANNEL).
MAX_CHANNEL=8
# Total live streams and main-quality streams allowed at once.
MAX_LIVE_STREAMS=6
MAX_MAIN_STREAMS=2
# A stream not renewed within the timeout is deleted by the reaper.
LEASE_TIMEOUT_SECONDS=30
LEASE_CHECK_INTERVAL_SECONDS=5

# Recordings through the DVR CGI API (Phase 4a).
# Some devices report items one channel lower than the requested channel.
RESPONSE_CHANNEL_OFFSET=-1
# How long one finder result is cached, in seconds (0 disables the cache).
RECORDINGS_CACHE_SECONDS=60

# Recorded playback through go2rtc (Phase 4b).
# Playback streams have their own limit and do not count as live streams.
MAX_PLAYBACK_STREAMS=2
# Longest playback request allowed, in seconds (30..PLAYBACK_MAX_SECONDS).
# The browser asks for 600 seconds by default.
PLAYBACK_MAX_SECONDS=3600

# Device registry (Phase 5a).
# APP_SECRET_KEY is a Fernet key. Generate one and paste only the value:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without a valid key the registry endpoints return 503 and the rest of the
# app keeps working.
APP_SECRET_KEY=replace-with-a-generated-fernet-key
# SQLite database location. Relative paths are resolved from the app folder.
DATA_DIR=./data
# Background online-status check interval, concurrency, and per-port timeout.
STATUS_INTERVAL_SECONDS=60
STATUS_CONCURRENCY=10
STATUS_TIMEOUT_SECONDS=2
# Allow public IP addresses as device hosts. Keep false on a LAN.
ALLOW_PUBLIC_HOSTS=false
